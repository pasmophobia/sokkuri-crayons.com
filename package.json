{
	"name": "artc",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && astro preview",
		"astro": "astro",
		"generate-types": "wrangler types",
		"deploy": "astro build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"auth:generate": "better-auth generate --config auth.config.ts --output auth.schema.sql -y",
		"db:migrate": "wrangler d1 migrations apply artc-auth --local",
		"db:migrate:remote": "wrangler d1 migrations apply artc-auth --remote"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.1.6",
		"@astrojs/react": "^6.0.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"agents": "^0.20.1",
		"astro": "^7.1.5",
		"better-auth": "^1.6.25",
		"better-auth-cloudflare": "^0.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"wrangler": "^4.115.0"
	}
}
