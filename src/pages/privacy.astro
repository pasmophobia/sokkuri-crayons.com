---
import { useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";

/* 実装に合わせて書いてある。扱う情報を増やしたら辞書の privacy.* も直すこと。 */
const t = useTranslations(Astro.locals.locale);
---

<Base title={t("privacy.title")}>
	<div class="prose">
		<h1>{t("privacy.title")}</h1>
		<p class="muted">{t("privacy.updated", { date: t("privacy.updatedAt") })}</p>

		<p>{t("privacy.intro")}</p>

		<h2>{t("privacy.h1")}</h2>
		<ul>
			<li><strong>{t("privacy.collectAccountTerm")}</strong> — {t("privacy.collectAccount")}</li>
			<li><strong>{t("privacy.collectPostTerm")}</strong> — {t("privacy.collectPost")}</li>
			<li><strong>{t("privacy.collectFriendTerm")}</strong> — {t("privacy.collectFriend")}</li>
			<li>
				<strong>{t("privacy.collectConnectionTerm")}</strong> — {t("privacy.collectConnection")}
			</li>
			<li><strong>{t("privacy.collectCookieTerm")}</strong> — {t("privacy.collectCookie")}</li>
		</ul>
		<p>{t("privacy.noTracking")}</p>

		<h2>{t("privacy.h2")}</h2>
		<ul>
			<li>{t("privacy.purpose1")}</li>
			<li>{t("privacy.purpose2")}</li>
			<li>{t("privacy.purpose3")}</li>
			<li>{t("privacy.purpose4")}</li>
		</ul>

		<h2>{t("privacy.h3")}</h2>
		<p>{t("privacy.visibility")}</p>

		<h2>{t("privacy.h4")}</h2>
		<p>{t("privacy.storage")}</p>

		<h2>{t("privacy.h5")}</h2>
		<p>{t("privacy.retention")}</p>

		<h2>{t("privacy.h6")}</h2>
		<p>{t("privacy.security")}</p>

		<h2>{t("privacy.h7")}</h2>
		<p>{t("privacy.children")}</p>

		<h2>{t("privacy.h8")}</h2>
		<p>{t("privacy.changes")}</p>

		<h2>{t("privacy.h9")}</h2>
		<p>
			{t("privacy.operator")}<br />
			{t("privacy.contact")}
		</p>
	</div>
</Base>
