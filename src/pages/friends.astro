---
import { env } from "cloudflare:workers";

import FriendManager from "../components/FriendManager";
import { localePath, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";
import { listFriends, listIncomingRequests, listOutgoingRequests } from "../lib/friends";

const user = Astro.locals.user;
const locale = Astro.locals.locale;
if (!user) return Astro.redirect(localePath(locale, "/signin"));

const t = useTranslations(locale);

const [friends, incoming, outgoing, me] = await Promise.all([
	listFriends(env.DB, user.id),
	listIncomingRequests(env.DB, user.id),
	listOutgoingRequests(env.DB, user.id),
	env.DB.prepare(
		`select coalesce("displayUsername", "username") as "username" from "user" where "id" = ?1`,
	)
		.bind(user.id)
		.first<{ username: string | null }>(),
]);
---

<Base title={t("friends.title")}>
	<div class="feed-page">
		<h1>{t("friends.title")}</h1>
		<FriendManager
			client:load
			locale={locale}
			myUsername={me?.username ?? null}
			friends={friends}
			incoming={incoming}
			outgoing={outgoing}
		/>
	</div>
</Base>
