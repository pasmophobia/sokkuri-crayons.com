---
import { env } from "cloudflare:workers";

import Base from "../layouts/Base.astro";
import { mediaUrl, thumbnailKey } from "../lib/media";
import { listPosts } from "../lib/posts";

const posts = await listPosts(env.DB);
const user = Astro.locals.user;
const formatter = new Intl.DateTimeFormat("ja-JP", { dateStyle: "short", timeStyle: "short" });
---

<Base title="タイムライン">
	<h1>タイムライン</h1>

	{
		posts.length === 0 ? (
			<p class="empty">
				まだ投稿がありません。
				{user ? (
					<a href="/posts/new">最初の 1 枚を投稿</a>
				) : (
					<a href="/signup">登録すると投稿できます</a>
				)}
			</p>
		) : (
			<ul class="feed">
				{posts.map((post) => (
					<li class="card">
						<a href={`/posts/${post.id}`}>
							{/* 落書きを焼き込んだサムネイル。まだ焼かれていなければ元画像。 */}
							<img
								src={
									post.thumbnailUpdatedAt
										? mediaUrl(thumbnailKey(post.id), post.thumbnailUpdatedAt)
										: mediaUrl(post.imageKey)
								}
								alt={post.caption}
								loading="lazy"
							/>
							<div class="meta">
								<div class="caption">{post.caption || "（キャプションなし）"}</div>
								<div class="muted">
									{post.authorName} · {formatter.format(post.createdAt)}
								</div>
							</div>
						</a>
					</li>
				))}
			</ul>
		)
	}
</Base>
