---
import { env } from "cloudflare:workers";

import FeedThumbnail from "../components/FeedThumbnail";
import { dateFormatter, localePath, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";
import { mediaUrl } from "../lib/media";
import { listPosts } from "../lib/posts";

const user = Astro.locals.user;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const p = (path: string) => localePath(locale, path);

const posts = await listPosts(env.DB, user?.id ?? null);
const formatter = dateFormatter(locale, { dateStyle: "short", timeStyle: "short" });
---

<Base title={t("feed.title")}>
	<div class="feed-page">
		<h1>{t("feed.title")}</h1>

		{
			posts.length === 0 ? (
				<p class="empty">
					{t("feed.empty")}
					{user ? (
						<a href={p("/posts/new")}>{t("feed.emptyPostCta")}</a>
					) : (
						<a href={p("/signup")}>{t("feed.emptySignUpCta")}</a>
					)}
				</p>
			) : (
				<ul class="feed">
					{posts.map((post) => {
						const authorName = post.authorName ?? t("common.anonymous");
						return (
							<li class="card">
								<a href={p(`/posts/${post.id}`)}>
									{/* 落書きは見る側のブラウザがその場で描く。画面に入った分だけ。 */}
									<FeedThumbnail
										client:visible
										postId={post.id}
										imageUrl={mediaUrl(post.imageKey)}
										aspectRatio={post.aspectRatio}
										caption={post.caption}
									/>
									<div class="meta">
										<div class="byline">
											{post.authorImage ? (
												<img class="avatar" src={mediaUrl(post.authorImage)} alt="" />
											) : (
												<span class="avatar avatar-blank">{authorName.slice(0, 1)}</span>
											)}
											<span>{authorName}</span>
											<span class="muted">{formatter.format(post.createdAt)}</span>
											{post.visibility === "friends" && (
												<span class="badge">{t("feed.friendsOnly")}</span>
											)}
										</div>
										<div class="caption">{post.caption || t("common.noCaption")}</div>
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			)
		}
	</div>
</Base>
