---
import { env } from "cloudflare:workers";

import FeedThumbnail from "../components/FeedThumbnail";
import Base from "../layouts/Base.astro";
import { mediaUrl } from "../lib/media";
import { listPosts } from "../lib/posts";

const posts = await listPosts(env.DB);
const user = Astro.locals.user;
const formatter = new Intl.DateTimeFormat("ja-JP", { dateStyle: "short", timeStyle: "short" });
---

<Base title="タイムライン">
	<div class="feed-page">
	<h1>タイムライン</h1>

	{
		posts.length === 0 ? (
			<p class="empty">
				まだ投稿がありません。
				{user ? (
					<a href="/posts/new">最初の 1 枚を投稿</a>
				) : (
					<a href="/signup">登録すると投稿できます</a>
				)}
			</p>
		) : (
			<ul class="feed">
				{posts.map((post) => (
					<li class="card">
						<a href={`/posts/${post.id}`}>
							{/* 落書きは見る側のブラウザがその場で描く。画面に入った分だけ。 */}
							<FeedThumbnail
								client:visible
								postId={post.id}
								imageUrl={mediaUrl(post.imageKey)}
								aspectRatio={post.aspectRatio}
								caption={post.caption}
							/>
							<div class="meta">
								<div class="caption">{post.caption || "（キャプションなし）"}</div>
								<div class="muted">
									{post.authorName} · {formatter.format(post.createdAt)}
								</div>
							</div>
						</a>
					</li>
				))}
			</ul>
		)
	}
	</div>
</Base>
