---
import { env } from "cloudflare:workers";

import AccountSettings from "../components/AccountSettings";
import AvatarForm from "../components/AvatarForm";
import { dateFormatter, localePath, useTranslations } from "../i18n";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;
const locale = Astro.locals.locale;
if (!user) return Astro.redirect(localePath(locale, "/signin"));

const t = useTranslations(locale);

const account = await env.DB.prepare(
	`select u."name", u."email", u."image", u."createdAt",
	        coalesce(u."displayUsername", u."username") as "username",
	        (select count(*) from "post" p where p."authorId" = u."id") as "posts",
	        (select count(*) from "friendship" f
	          where f."status" = 'accepted'
	            and (f."requesterId" = u."id" or f."addresseeId" = u."id")) as "friends"
	 from "user" u where u."id" = ?1`,
)
	.bind(user.id)
	.first<{
		name: string;
		email: string;
		image: string | null;
		createdAt: string;
		username: string | null;
		posts: number;
		friends: number;
	}>();

const joined = account?.createdAt ? new Date(account.createdAt) : null;
const formatter = dateFormatter(locale, { dateStyle: "long" });
---

<Base title={t("account.title")}>
	<div class="feed-page">
		<h1>{t("account.title")}</h1>

		{
			account && (
				<>
					<section class="card account">
						<AvatarForm client:load locale={locale} current={account.image} name={account.name} />
						<dl>
							<dt>{t("account.displayName")}</dt>
							<dd>{account.name}</dd>
							<dt>{t("account.username")}</dt>
							<dd>
								{account.username ? (
									`@${account.username}`
								) : (
									<span class="muted">{t("account.usernameUnset")}</span>
								)}
							</dd>
							<dt>{t("account.email")}</dt>
							<dd>{account.email}</dd>
							<dt>{t("account.joined")}</dt>
							<dd>{joined ? formatter.format(joined) : "—"}</dd>
							<dt>{t("account.posts")}</dt>
							<dd>{account.posts}</dd>
							<dt>{t("account.friends")}</dt>
							<dd>
								<a href={localePath(locale, "/friends")}>{account.friends}</a>
							</dd>
						</dl>
					</section>

					<AccountSettings
						client:load
						locale={locale}
						name={account.name}
						username={account.username}
						email={account.email}
					/>
				</>
			)
		}
	</div>
</Base>
