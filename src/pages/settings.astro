---
import { env } from "cloudflare:workers";

import UsernameForm from "../components/UsernameForm";
import Base from "../layouts/Base.astro";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/signin");

const row = await env.DB.prepare(`select coalesce("displayUsername", "username") as "displayUsername" from "user" where "id" = ?1`)
	.bind(user.id)
	.first<{ displayUsername: string | null }>();
---

<Base title="設定">
	<div class="feed-page">
		<h1>設定</h1>
		<h2>ユーザー名</h2>
		<p class="muted">フレンド申請で相手に伝える ID です。</p>
		<UsernameForm client:load current={row?.displayUsername ?? null} />
	</div>
</Base>
