---
import { env } from "cloudflare:workers";

import DeletePostButton from "../../components/DeletePostButton";
import PostCanvas from "../../components/PostCanvas";
import Base from "../../layouts/Base.astro";
import { mediaUrl } from "../../lib/media";
import { getVisiblePost } from "../../lib/posts";

const { id } = Astro.params;
const user = Astro.locals.user;
const post = id ? await getVisiblePost(env.DB, id, user?.id ?? null) : null;
if (!post) return new Response(null, { status: 404, statusText: "Not Found" });

const formatter = new Intl.DateTimeFormat("ja-JP", { dateStyle: "short", timeStyle: "short" });
---

<Base title={post.caption || "投稿"}>
	<h1>{post.caption || "（キャプションなし）"}</h1>
	<p class="byline">
		{
			post.authorImage ? (
				<img class="avatar" src={mediaUrl(post.authorImage)} alt="" />
			) : (
				<span class="avatar avatar-blank">{post.authorName.slice(0, 1)}</span>
			)
		}
		<span>{post.authorName}</span>
		<span class="muted">{formatter.format(post.createdAt)}</span>
		{post.visibility === "friends" && <span class="badge">フレンドのみ</span>}
	</p>

	<PostCanvas
		client:load
		postId={post.id}
		imageUrl={mediaUrl(post.imageKey)}
		aspectRatio={post.aspectRatio}
		canEdit={user !== null}
	/>

	{user?.id === post.authorId && <DeletePostButton client:load postId={post.id} />}
</Base>
