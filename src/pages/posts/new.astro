---
import { env } from "cloudflare:workers";

import NewPostForm from "../../components/NewPostForm";
import { localePath, useTranslations } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { listFriends } from "../../lib/friends";

const user = Astro.locals.user;
const locale = Astro.locals.locale;
if (!user) return Astro.redirect(localePath(locale, "/signin"));

const t = useTranslations(locale);
const friends = await listFriends(env.DB, user.id);
---

<Base title={t("newPost.title")}>
	<h1>{t("newPost.title")}</h1>
	<NewPostForm client:load locale={locale} friendCount={friends.length} />
</Base>
