---
import Base from "../../layouts/Base.astro";
import { ALLOWED_IMAGE_TYPES, MAX_UPLOAD_BYTES } from "../../lib/media";

if (!Astro.locals.user) return Astro.redirect("/signin");

const accept = Object.keys(ALLOWED_IMAGE_TYPES).join(",");
const maxMb = Math.round(MAX_UPLOAD_BYTES / 1024 / 1024);
---

<Base title="投稿する">
	<h1>投稿する</h1>

	<form class="form" id="form">
		<label>
			画像（{maxMb}MB まで）
			<input type="file" name="image" accept={accept} required />
		</label>
		<label>
			キャプション
			<textarea name="caption" rows="3" maxlength="280"></textarea>
		</label>
		<p class="error" id="error"></p>
		<img id="preview" alt="" hidden style="max-width:100%;border-radius:10px" />
		<button class="primary" type="submit" id="submit" disabled>投稿する</button>
		<p class="muted">投稿すると、誰でもこの画像に落書きや歪みを加えられます。</p>
	</form>
</Base>

<script>
	import { MAX_UPLOAD_BYTES } from "../../lib/media";

	const form = document.getElementById("form") as HTMLFormElement;
	const fileInput = form.elements.namedItem("image") as HTMLInputElement;
	const preview = document.getElementById("preview") as HTMLImageElement;
	const submit = document.getElementById("submit") as HTMLButtonElement;
	const errorEl = document.getElementById("error")!;

	let file: File | null = null;
	// op は正規化座標なので、実座標に戻すのにアスペクト比が要る。
	let aspectRatio = 0;

	fileInput.addEventListener("change", () => {
		file = fileInput.files?.[0] ?? null;
		aspectRatio = 0;
		submit.disabled = true;
		preview.hidden = true;
		errorEl.textContent = "";
		if (!file) return;

		if (file.size > MAX_UPLOAD_BYTES) {
			errorEl.textContent = "画像が大きすぎます";
			return;
		}

		const objectUrl = URL.createObjectURL(file);
		const probe = new Image();
		probe.onload = () => {
			aspectRatio = probe.naturalWidth / probe.naturalHeight;
			preview.src = objectUrl;
			preview.hidden = false;
			submit.disabled = false;
		};
		probe.onerror = () => {
			URL.revokeObjectURL(objectUrl);
			errorEl.textContent = "画像を読み込めませんでした";
		};
		probe.src = objectUrl;
	});

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!file || !aspectRatio) return;
		submit.disabled = true;
		errorEl.textContent = "アップロード中…";

		const fail = async (response: Response, fallback: string) => {
			const body = (await response.json().catch(() => null)) as { message?: string } | null;
			errorEl.textContent = body?.message ?? fallback;
			submit.disabled = false;
		};

		// 1. 実体を R2 に上げてキーをもらう
		const upload = await fetch("/api/uploads", {
			method: "POST",
			headers: { "content-type": file.type },
			body: file,
		});
		if (!upload.ok) return fail(upload, "アップロードできませんでした");
		const { key } = (await upload.json()) as { key: string };

		// 2. そのキーで投稿レコードを作る
		errorEl.textContent = "投稿中…";
		const data = new FormData(form);
		const created = await fetch("/api/posts", {
			method: "POST",
			headers: { "content-type": "application/json" },
			body: JSON.stringify({
				imageKey: key,
				aspectRatio,
				caption: String(data.get("caption") ?? ""),
			}),
		});
		if (!created.ok) return fail(created, "投稿できませんでした");

		const { id } = (await created.json()) as { id: string };
		location.href = `/posts/${id}`;
	});
</script>
