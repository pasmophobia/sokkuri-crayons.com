---
import SignOutButton from "../components/SignOutButton";
import { LOCALES, LOCALE_LABELS, localePath, useTranslations } from "../i18n";
import { mediaUrl } from "../lib/media";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const locale = Astro.locals.locale;
const t = useTranslations(locale);

/** このロケールでのリンク先。 */
const p = (path: string) => localePath(locale, path);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | {t("common.brand")}</title>
		{/* 同じ内容の別言語版を検索エンジンに伝える。パスは middleware が剥がす前のもの。 */}
		{
			LOCALES.map((other) => (
				<link
					rel="alternate"
					hreflang={other}
					href={new URL(localePath(other, Astro.locals.path), Astro.url).href}
				/>
			))
		}
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={p("/")}>{t("common.brand")}</a>
			{
				/*
			  開閉の文言は下のスクリプトが差し替える。あちらはバンドルされるモジュールで
			  Astro.locals を見られないので、data 属性で渡しておく。
			*/
			}
			<button
				class="nav-toggle"
				type="button"
				aria-controls="site-nav"
				aria-expanded="false"
				aria-label={t("nav.menuOpen")}
				data-label-open={t("nav.menuOpen")}
				data-label-close={t("nav.menuClose")}
			>
				<span class="nav-toggle-icon" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>
			<nav id="site-nav">
				{
					user ? (
						<>
							<a href={p("/friends")}>{t("nav.friends")}</a>
							<a href={p("/posts/new")}>{t("nav.newPost")}</a>
							<a class="me" href={p("/settings")}>
								{user.image ? (
									<img class="avatar" src={mediaUrl(user.image)} alt="" />
								) : (
									<span class="avatar avatar-blank">{user.name.slice(0, 1)}</span>
								)}
								<span class="muted">{user.name}</span>
							</a>
							<SignOutButton client:load locale={locale} />
						</>
					) : (
						<>
							<a href={p("/signin")}>{t("nav.signIn")}</a>
							<a href={p("/signup")}>{t("nav.signUp")}</a>
						</>
					)
				}
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-about">
					<span class="brand">{t("common.brand")}</span>
					<p class="muted">{t("footer.tagline")}</p>
				</div>
				<nav class="footer-links">
					<a href={p("/")}>{t("nav.timeline")}</a>
					{
						user ? (
							<>
								<a href={p("/posts/new")}>{t("nav.newPost")}</a>
								<a href={p("/friends")}>{t("nav.friends")}</a>
								<a href={p("/settings")}>{t("nav.account")}</a>
							</>
						) : (
							<>
								<a href={p("/signin")}>{t("nav.signIn")}</a>
								<a href={p("/signup")}>{t("nav.signUp")}</a>
							</>
						)
					}
					<a href={p("/statement")}>{t("nav.statement")}</a>
					<a href={p("/privacy")}>{t("nav.privacy")}</a>
				</nav>
				{
					/*
				  いま見ているページのまま言語だけ差し替える。middleware が
				  接頭辞の有無から Cookie を書き直すので、次からはその言語で開く。
				*/
				}
				<nav class="footer-locales" aria-label={t("common.language")}>
					{
						LOCALES.map((other) =>
							other === locale ? (
								<span class="muted" aria-current="true">
									{LOCALE_LABELS[other]}
								</span>
							) : (
								<a href={localePath(other, Astro.locals.path)} hreflang={other} lang={other}>
									{LOCALE_LABELS[other]}
								</a>
							),
						)
					}
				</nav>
			</div>
			<p class="copyright">© 2026 pasmophobia. All rights reserved.</p>
		</footer>
		<script>
			// ハンバーガーの開閉。開いた状態はヘッダーの data 属性だけで表し、
			// 表示の切り替えはメディアクエリ側に任せる。
			const header = document.querySelector<HTMLElement>(".site-header");
			const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");

			if (header && toggle) {
				// 文言はサーバが data 属性に載せている（ここは言語を知らない）。
				const openLabel = toggle.dataset.labelOpen ?? "";
				const closeLabel = toggle.dataset.labelClose ?? "";

				const setOpen = (open: boolean) => {
					header.toggleAttribute("data-nav-open", open);
					toggle.setAttribute("aria-expanded", String(open));
					toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
				};

				toggle.addEventListener("click", () => {
					setOpen(!header.hasAttribute("data-nav-open"));
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && header.hasAttribute("data-nav-open")) {
						setOpen(false);
						toggle.focus();
					}
				});

				// 横幅が広がるとナビは常時表示に戻るので、開いた状態を持ち越さない。
				const wide = window.matchMedia("(min-width: 48rem)");
				wide.addEventListener("change", (event) => {
					if (event.matches) setOpen(false);
				});
			}
		</script>
	</body>
</html>
