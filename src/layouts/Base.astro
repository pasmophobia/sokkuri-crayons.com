---
import SignOutButton from "../components/SignOutButton";
import { mediaUrl } from "../lib/media";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | そっくりクレヨン</title>
		<noscript>
			<!--
				キャンバスは JS が焼く。動かないなら焼き上がりは来ないので、
				待っている見た目（ぼかし）をやめて元画像をそのまま見せる。
			-->
			<style>
				[data-phase="loading"] > img {
					filter: none !important;
					transform: none !important;
					animation: none !important;
				}
				[data-phase="loading"] > canvas {
					display: none;
				}
			</style>
		</noscript>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">そっくりクレヨン</a>
			<button
				class="nav-toggle"
				type="button"
				aria-controls="site-nav"
				aria-expanded="false"
				aria-label="メニューを開く"
			>
				<span class="nav-toggle-icon" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>
			<nav id="site-nav">
				{
					user ? (
						<>
							<a href="/friends">フレンド</a>
							<a href="/posts/new">投稿する</a>
							<a class="me" href="/settings">
								{user.image ? (
									<img class="avatar" src={mediaUrl(user.image)} alt="" />
								) : (
									<span class="avatar avatar-blank">{user.name.slice(0, 1)}</span>
								)}
								<span class="muted">{user.name}</span>
							</a>
							<SignOutButton client:load />
						</>
					) : (
						<>
							<a href="/signin">ログイン</a>
							<a href="/signup">登録</a>
						</>
					)
				}
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-about">
					<span class="brand">そっくりクレヨン</span>
					<p class="muted">
						写真をなぞって落書きと歪みを重ね、フレンドと見せ合うための小さな場所です。
					</p>
				</div>
				<nav class="footer-links">
					<a href="/">タイムライン</a>
					{
						user ? (
							<>
								<a href="/posts/new">投稿する</a>
								<a href="/friends">フレンド</a>
								<a href="/settings">アカウント</a>
							</>
						) : (
							<>
								<a href="/signin">ログイン</a>
								<a href="/signup">登録</a>
							</>
						)
					}
					<a href="/statement">ステートメント</a>
					<a href="/privacy">プライバシーポリシー</a>
				</nav>
			</div>
			<p class="copyright">© 2026 pasmophobia. All rights reserved.</p>
		</footer>
		<script>
			// ハンバーガーの開閉。開いた状態はヘッダーの data 属性だけで表し、
			// 表示の切り替えはメディアクエリ側に任せる。
			const header = document.querySelector<HTMLElement>(".site-header");
			const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");

			if (header && toggle) {
				const setOpen = (open: boolean) => {
					header.toggleAttribute("data-nav-open", open);
					toggle.setAttribute("aria-expanded", String(open));
					toggle.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
				};

				toggle.addEventListener("click", () => {
					setOpen(!header.hasAttribute("data-nav-open"));
				});

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && header.hasAttribute("data-nav-open")) {
						setOpen(false);
						toggle.focus();
					}
				});

				// 横幅が広がるとナビは常時表示に戻るので、開いた状態を持ち越さない。
				const wide = window.matchMedia("(min-width: 48rem)");
				wide.addEventListener("change", (event) => {
					if (event.matches) setOpen(false);
				});
			}
		</script>
	</body>
</html>
