---
import SignOutButton from "../components/SignOutButton";
import { mediaUrl } from "../lib/media";
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | クレヨン</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/">クレヨン</a>
			<nav>
				{
					user ? (
						<>
							<a href="/friends">フレンド</a>
							<a href="/posts/new">投稿する</a>
							<a class="me" href="/settings">
								{user.image ? (
									<img class="avatar" src={mediaUrl(user.image)} alt="" />
								) : (
									<span class="avatar avatar-blank">{user.name.slice(0, 1)}</span>
								)}
								<span class="muted">{user.name}</span>
							</a>
							<SignOutButton client:load />
						</>
					) : (
						<>
							<a href="/signin">ログイン</a>
							<a href="/signup">登録</a>
						</>
					)
				}
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
